# =============================================================================
# Homepage secrets and private settings
# -----------------------------------------------------------------------------
# Setup:
#   cp homepage.env.example homepage.env
#   chmod 600 homepage.env        # readable by your user only
#   docker compose up -d          # re-run after every change
#
# Each HOMEPAGE_VAR_* value is injected into config/*.yaml wherever
# {{HOMEPAGE_VAR_...}} appears. homepage.env is git-ignored: never commit it.
#
# Warning: fill in real credentials before enabling a widget. A widget with
# wrong credentials retries the login over and over, and qBittorrent bans
# the IP after 5 failed attempts (which also locks you out of its web UI).
# =============================================================================


# --- API keys ----------------------------------------------------------------

# Sonarr / Radarr / Prowlarr: Settings → General → Security → API Key
HOMEPAGE_VAR_SONARR_KEY=
HOMEPAGE_VAR_RADARR_KEY=
HOMEPAGE_VAR_PROWLARR_KEY=

# Plex: open any item in Plex Web → ⋯ → Get Info → View XML,
# then copy the X-Plex-Token value from the URL
HOMEPAGE_VAR_PLEX_TOKEN=


# --- Web UI logins -----------------------------------------------------------
# Same credentials you use to sign in to each panel.

HOMEPAGE_VAR_ADGUARD_USER=
HOMEPAGE_VAR_ADGUARD_PASS=

# Nginx Proxy Manager signs in with an email address
HOMEPAGE_VAR_NPM_EMAIL=
HOMEPAGE_VAR_NPM_PASS=

HOMEPAGE_VAR_QBIT_USER=
HOMEPAGE_VAR_QBIT_PASS=


# --- Network -----------------------------------------------------------------
# Example values use 192.0.2.0/24, a range reserved for documentation.

# Hostnames Homepage answers to (it rejects requests for any other Host)
HOMEPAGE_ALLOWED_HOSTS=hub.lan,192.0.2.10:3010

# LAN address of the server running the services
HOMEPAGE_VAR_PI_IP=192.0.2.10

# Router admin page, shown as a bookmark
HOMEPAGE_VAR_ROUTER_IP=192.0.2.1


# --- Weather widget ----------------------------------------------------------
# Label shown on the dashboard and coordinates in decimal degrees.
# Tip: right-click a spot in Google Maps to copy its coordinates.

HOMEPAGE_VAR_WEATHER_LABEL=Madrid
HOMEPAGE_VAR_WEATHER_LAT=40.4168
HOMEPAGE_VAR_WEATHER_LON=-3.7038
