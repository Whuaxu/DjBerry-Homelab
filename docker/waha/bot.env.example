# =============================================================================
# WAHA bot settings
# -----------------------------------------------------------------------------
# Setup:
#   cp bot.env.example bot.env
#   chmod 600 bot.env             # readable by your user only
#   docker compose up -d          # re-run after every change
#
# bot.env is git-ignored: never commit it.
# =============================================================================


# Same value as WAHA_API_KEY in waha.env
WAHA_API_KEY=

# Who can give the bot commands. International format, digits only (no "+"),
# comma-separated. Messages from any other number are ignored.
# Example (fictional numbers): 34600000000,34611111111
ALLOWED_NUMBERS=

# WAHA session the bot uses for messages it sends on its own (reminders)
WAHA_SESSION=default

# Daily reminders, as JSON on a single line. Times are local (TZ in compose.yml).
# Group ids end in @g.us: list them with GET /api/<session>/groups.
# Optional "doneCommand": writing it (in the reminder's chat, in the chat with
# yourself or from an allowed number) cancels that reminder for the day.
# Example (fictional id):
# DAILY_REMINDERS=[{"time":"11:00","chatId":"120363000000000000@g.us","text":"[REMINDER] Water the plants","doneCommand":"/plants"}]
DAILY_REMINDERS=[]

# /jitsi: base URL for meeting links (change it if you self-host Jitsi)
JITSI_URL=https://meet.jit.si

# /status: service health read from Uptime Kuma's /metrics endpoint.
# Create the key in Kuma: Settings -> API Keys -> Generate (no expiry needed).
# KUMA_URL is Kuma as seen from the bot container (the Pi's LAN IP + port).
KUMA_URL=http://192.168.1.10:3001
KUMA_API_KEY=
