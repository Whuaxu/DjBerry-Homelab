# =============================================================================
# WAHA secrets
# -----------------------------------------------------------------------------
# Setup:
#   cp waha.env.example waha.env
#   chmod 600 waha.env            # readable by your user only
#   docker compose up -d          # re-run after every change
#
# waha.env is git-ignored: never commit it. Generate each value with:
#   openssl rand -hex 32
# and keep a copy in your password manager.
# =============================================================================


# --- API key -----------------------------------------------------------------
# Every request must send it in the X-Api-Key header (only /ping is exempt).
# Your bot and the dashboard both need it.
WAHA_API_KEY=


# --- Dashboard (/dashboard) --------------------------------------------------
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=


# --- Swagger API docs (/) ----------------------------------------------------
WHATSAPP_SWAGGER_USERNAME=admin
WHATSAPP_SWAGGER_PASSWORD=
